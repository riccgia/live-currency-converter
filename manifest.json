{
  "manifest_version": 3,
  "name": "Live Currency Converter",
  "version": "0.1.0",
  "description": "Rewrites prices on any webpage into your preferred currency using live exchange rates.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Live Currency Converter"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://open.er-api.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": []
}
